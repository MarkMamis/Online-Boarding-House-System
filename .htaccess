<IfModule mod_rewrite.c>
    RewriteEngine On

    # Disable directory browsing
    Options -Indexes

    # 1. Allow .well-known for automated SSL validation (Let's Encrypt / Hostinger SSL)
    RewriteRule ^\.well-known/ - [L]

    # 2. Block direct HTTP access to hidden files and dotfiles (.env, .git, etc.)
    RewriteRule (^|/)\. - [F,L]

    # 3. Block direct HTTP access to sensitive root application files and directories
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor|node_modules)(/.*)?$ - [F,L]
    RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.(js|ts)|Dockerfile|\.env.*)$ - [F,L]

    # 4. If the requested file physically exists inside public/, serve it directly
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^(.*)$ public/$1 [L]

    # 5. Direct front-controller routing: route all application paths directly to public/index.php
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^ public/index.php [L]
</IfModule>

# Fallback block for hidden files if mod_rewrite is not active
<FilesMatch "^\.">
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# Fallback block for sensitive root files
<FilesMatch "^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.(js|ts)|\.env.*)$">
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>