# =====================================================================
# OBHS PRODUCTION ENVIRONMENT TEMPLATE FOR HOSTINGER SHARED HOSTING
# =====================================================================
# Copy this file to .env in your Hostinger public_html directory.
# NEVER commit real credentials to Git or include them in public repos.
# =====================================================================

APP_NAME="OBHS"
APP_ENV=production
APP_KEY=base64:GENERATE_OR_PASTE_YOUR_APP_KEY_HERE
APP_DEBUG=false
APP_URL=https://mcc-boardinghouse.online

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# =====================================================================
# HOSTINGER MYSQL DATABASE
# In Hostinger hPanel -> Databases -> MySQL Databases:
# DB_HOST is usually 'localhost' or '127.0.0.1' on Hostinger Shared Hosting
# =====================================================================
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=HOSTINGER_DATABASE_NAME
DB_USERNAME=HOSTINGER_DATABASE_USERNAME
DB_PASSWORD=HOSTINGER_DATABASE_PASSWORD

# =====================================================================
# SESSION & CACHE (Shared-Hosting Compatible)
# - SESSION_DRIVER: database (uses the 'sessions' table created by migration)
# - SESSION_SECURE_COOKIE: true ensures cookies are HTTPS-only on production
# - CACHE_STORE: file or database (no Redis server required)
# =====================================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync

# =====================================================================
# FILESYSTEM STORAGE
# Default is 'public' (local server storage with php artisan storage:link).
# If using Cloudflare R2 or Supabase, set FILESYSTEM_DISK=r2 or supabase.
# =====================================================================
FILESYSTEM_DISK=public

# Cloudflare R2 Object Storage (Optional - private S3-compatible cloud storage)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mcc-boarding-files
R2_ENDPOINT=https://YOUR_CLOUDFLARE_ACCOUNT_ID.r2.cloudflarestorage.com
R2_REGION=auto
R2_URL=
R2_USE_PATH_STYLE_ENDPOINT=false

# Supabase Storage (Optional - legacy S3-compatible cloud storage)
SUPABASE_STORAGE_KEY=
SUPABASE_STORAGE_SECRET=
SUPABASE_STORAGE_REGION=
SUPABASE_STORAGE_BUCKET=boarding-house-files
SUPABASE_STORAGE_ENDPOINT=

# =====================================================================
# MAIL CONFIGURATION (Hostinger Titan Webmail / SMTP)
# =====================================================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=notifications@mcc-boardinghouse.online
MAIL_PASSWORD=YOUR_EMAIL_PASSWORD
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="notifications@mcc-boardinghouse.online"
MAIL_FROM_NAME="${APP_NAME}"

# =====================================================================
# AI CHATBOT (Hugging Face API)
# =====================================================================
HF_TOKEN=
HF_MODEL=Qwen/Qwen3.8-27B:cerebras
HF_QWEN_MODEL=Qwen/Qwen3.8-27B:cerebras

# =====================================================================
# DEPLOYMENT HELPER TOKEN (Optional)
# Used if running public/hostinger-setup.php for web-based first migration
# =====================================================================
SETUP_SECRET=YOUR_RANDOM_SECRET_SETUP_KEY
